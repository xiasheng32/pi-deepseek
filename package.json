{
  "name": "pi-deepseek",
  "version": "0.2.0",
  "description": "Pi extension: 在页脚状态栏显示 DeepSeek 账户余额，并提供 /pi-deepseek 详情面板命令。",
  "keywords": [
    "pi-package",
    "pi-extension",
    "deepseek",
    "balance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiasheng32/pi-deepseek.git"
  },
  "homepage": "https://github.com/xiasheng32/pi-deepseek#readme",
  "bugs": {
    "url": "https://github.com/xiasheng32/pi-deepseek/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions/index.ts",
    "src/balance.ts",
    "scripts/sync-autoload.ts",
    "tests/pi-deepseek.test.ts",
    "tests/extension.test.ts",
    "tests/sync-autoload.test.ts",
    "tsconfig.json",
    ".env.example",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/pi-deepseek.test.ts tests/extension.test.ts tests/sync-autoload.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "sync-autoload": "node scripts/sync-autoload.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
